# Normalize line endings.
* text=auto eol=lf

*.md     text
*.txt    text
*.json   text
*.cmake  text
*.cpp    text
*.h      text
*.mm     text

# Binary formats.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.mp3  binary
*.wav  binary
*.ogg  binary
*.mp4  binary
*.mov  binary
